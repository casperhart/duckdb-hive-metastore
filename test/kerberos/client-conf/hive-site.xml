<?xml version="1.0"?>
<!--
  Client-side hive-site.xml consumed by the extension via HADOOP_CONF_DIR.
  Drives the extension's auto-discovery: it reads the URI here and, because
  sasl is enabled, authenticates with Kerberos using the ambient ticket. The
  principal below carries a concrete instance ("localhost"), which the
  extension uses verbatim as the SPN — hive/localhost@EXAMPLE.COM — with no
  DNS canonicalization. This also exercises the concrete-instance (non-_HOST)
  code path.
-->
<configuration>
    <!-- The trailing dot only affects TCP name resolution now (the SPN comes
         from the principal, not the endpoint host); it keeps the resolver from
         appending a search domain (e.g. a router's ".internal"). -->
    <property>
        <name>hive.metastore.uris</name>
        <value>thrift://localhost.:9083</value>
    </property>
    <property>
        <name>hive.metastore.sasl.enabled</name>
        <value>true</value>
    </property>
    <property>
        <name>hive.metastore.kerberos.principal</name>
        <value>hive/localhost@EXAMPLE.COM</value>
    </property>
</configuration>
