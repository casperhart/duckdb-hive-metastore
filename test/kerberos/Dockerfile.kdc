# Minimal MIT Kerberos KDC + admin server for the kerberized-metastore test.
# For LOCAL TESTING ONLY — permissive ACL, fixed master key, throwaway realm.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        krb5-kdc krb5-admin-server krb5-user && \
    rm -rf /var/lib/apt/lists/*

# Permissive kadmin ACL (test realm only).
RUN mkdir -p /etc/krb5kdc && printf '*/admin@EXAMPLE.COM\t*\n' > /etc/krb5kdc/kadm5.acl

COPY kdc-entrypoint.sh /usr/local/bin/kdc-entrypoint.sh
RUN chmod +x /usr/local/bin/kdc-entrypoint.sh

EXPOSE 88/udp 88/tcp 749/tcp
ENTRYPOINT ["/usr/local/bin/kdc-entrypoint.sh"]
